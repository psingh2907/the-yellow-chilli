# "false" for the production site (indexable, no preview banner).
NEXT_PUBLIC_PROTOTYPE_MODE=true
# Public URL, used for canonical links, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://example.netlify.app
# Google Analytics 4 measurement ID (optional).
NEXT_PUBLIC_GA_ID=

# Supabase (Dashboard → Project Settings → API Keys / Data API).
# The URL and publishable key are safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_, never commit. Bypasses RLS.
SUPABASE_SECRET_KEY=
